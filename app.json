{
  "expo": {
    "name": "led_controller",
    "slug": "led_controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lights.jpg",
    "scheme": "ledcontroller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.smritinaik.ledcontroller",
      "adaptiveIcon": {
        "backgroundColor": "#E4F5D0",
        "foregroundImage": "./assets/images/lights.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/lights.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46d7039c-fed6-493b-b222-85d26cf5c80e"
      }
    }
  }
}